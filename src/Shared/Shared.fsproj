<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Budgeting.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Remoting.Giraffe" Version="5.16.0" />
    <!-- Hebt das transitive Newtonsoft.Json 12.0.3 aus Fable.Remoting an (GHSA-5crp-9r3c-p9vr).
         Seit SDK 10 meldet der NuGet-Audit auch transitive Pakete (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
