<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- Erzwingt USE_MEMORY_DB=true fuer `dotnet test` (VSTest ruft nie den
         Einstiegspunkt in Main.fs auf, siehe dort und test.runsettings). -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
    <!-- Die Tests laufen ohne Kulturdaten, wie der Server im Alpine-Container
         (aspnet:9.0-alpine, kein ICU). Sonst bleibt ein Zugriff auf "de-DE"
         lokal grün und wirft erst in Produktion (Historie 500, 2026-10-20). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wächter gegen ADR 0030 (infra-za7fq): muss vor jedem Test stehen, der die
         Datenbank anfasst, damit ein Rückfall auf die Datei-Datenbank sofort und
         laut auffällt. -->
    <Compile Include="TestDatabaseGuardTests.fs" />
    <!-- Mechanisierte Durchsetzung der Konvention "DB-Setup nur in testCase-Closures"
         (infra-sdad8, Iteration 2): muss nicht vor den DB-Tests stehen wie der Wächter
         oben, prüft aber deren Quelltext statisch, unabhängig von der Compile-Reihenfolge. -->
    <Compile Include="ModuleLevelDbInitGuardTests.fs" />
    <Compile Include="RemoteDataTests.fs" />
    <Compile Include="ServerConfigTests.fs" />
    <!-- Mechanisierte Durchsetzung von "app.Run() bekommt nie ein URL-Argument"
         (infra-jh7g9, Iteration 2, ADR 0034): liest Program.fs selbst, unabhängig
         von der Compile-Reihenfolge, muss also nicht vor anderen Tests stehen. -->
    <Compile Include="BackendPortGuardTests.fs" />
    <Compile Include="EncryptionTests.fs" />
    <Compile Include="PersistenceTypeConversionTests.fs" />
    <Compile Include="YnabClientTests.fs" />
    <Compile Include="YnabIntegrationTests.fs" />
    <Compile Include="ComdirectClientTests.fs" />
    <Compile Include="ComdirectDecoderTests.fs" />
    <Compile Include="ComdirectIntegrationTests.fs" />
    <Compile Include="RulesEngineTests.fs" />
    <Compile Include="DuplicateDetectionTests.fs" />
    <Compile Include="OrderIdMatcherTests.fs" />
    <Compile Include="BudgetingTests.fs" />
    <Compile Include="TargetsApplyTests.fs" />
    <Compile Include="SplitTransactionTests.fs" />
    <Compile Include="SplitPushTests.fs" />
    <Compile Include="ImportAskLenaTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="SyncSessionManagerTests.fs" />
    <Compile Include="RoutingTests.fs" />
    <Compile Include="SyncFlowViewTests.fs" />
    <Compile Include="SyncFlowStateTests.fs" />
    <Compile Include="ImportAskLenaClientTests.fs" />
    <Compile Include="QuickAddTests.fs" />
    <Compile Include="PwaTests.fs" />
    <Compile Include="RetryTests.fs" />
    <Compile Include="AppReadinessTests.fs" />
    <Compile Include="LedgerCategoriesSyncTests.fs" />
    <Compile Include="LedgerCategoriesAwaitSettingsTests.fs" />
    <Compile Include="LedgerCategoriesFreshnessTests.fs" />
    <Compile Include="SplitEditorTests.fs" />
    <Compile Include="RulesReorderTests.fs" />
    <Compile Include="CategoryPickerTests.fs" />
    <Compile Include="ToastLifecycleTests.fs" />
    <Compile Include="FontFaceRegressionTests.fs" />
    <Compile Include="TailwindClassGuardTests.fs" />
    <Compile Include="LedgerTests.fs" />
    <Compile Include="LedgerMirrorTests.fs" />
    <Compile Include="LedgerReviewMarkTests.fs" />
    <Compile Include="LedgerCategoryChangeTests.fs" />
    <Compile Include="LedgerSplitWriteTests.fs" />
    <Compile Include="LedgerSplitReadTests.fs" />
    <Compile Include="LedgerReviewMarkBatchTests.fs" />
    <Compile Include="LedgerCategoryBatchTests.fs" />
    <Compile Include="LedgerLenaFlagTests.fs" />
    <Compile Include="LedgerLenaFlagBatchTests.fs" />
    <Compile Include="LedgerReviewMarkClientTests.fs" />
    <Compile Include="LedgerPushFailureTests.fs" />
    <Compile Include="LedgerRetryPushTests.fs" />
    <Compile Include="LedgerMemoTests.fs" />
    <Compile Include="ForceImportCandidateTests.fs" />
    <Compile Include="PushOutcomeClassificationTests.fs" />
    <Compile Include="LedgerPageTests.fs" />
    <Compile Include="LedgerViewTests.fs" />
    <Compile Include="LedgerReviewButtonVisibilityTests.fs" />
    <Compile Include="LedgerVisibleColumnsTests.fs" />
    <Compile Include="LedgerFilterButtonTests.fs" />
    <Compile Include="LedgerPagingTests.fs" />
    <Compile Include="LedgerSortTests.fs" />
    <Compile Include="LedgerSortClientTests.fs" />
    <Compile Include="LedgerSortSheetTests.fs" />
    <Compile Include="LedgerAccountChoiceTests.fs" />
    <Compile Include="LedgerPayeeCategorySuggestionsTests.fs" />
    <Compile Include="LedgerRecentCategoriesTests.fs" />
    <Compile Include="LedgerCategoryChangeClientTests.fs" />
    <Compile Include="LedgerSplitEditorClientTests.fs" />
    <Compile Include="LedgerWithoutCategoryTests.fs" />
    <Compile Include="LedgerReviewStateTests.fs" />
    <Compile Include="LedgerSelectionTests.fs" />
    <Compile Include="LedgerCompactInteractionTests.fs" />
    <Compile Include="LedgerDetailTests.fs" />
    <Compile Include="LedgerNotInYnabClientTests.fs" />
    <Compile Include="LedgerMemoClientTests.fs" />
    <Compile Include="LedgerReviewMarkBatchClientTests.fs" />
    <Compile Include="LedgerCategoryBatchClientTests.fs" />
    <Compile Include="LedgerLenaFlagClientTests.fs" />
    <Compile Include="LedgerLenaFlagBatchClientTests.fs" />
    <Compile Include="LedgerKeyboardTests.fs" />
    <Compile Include="MoneyFormatTests.fs" />
    <Compile Include="BudgetPageTests.fs" />
    <Compile Include="TargetsApplyClientTests.fs" />
    <Compile Include="StatsAccentTests.fs" />
    <Compile Include="DesignSystemStartupTests.fs" />
    <Compile Include="TextGlowTokenTests.fs" />
    <Compile Include="RuhigeListenTests.fs" />
    <Compile Include="AuswahlTests.fs" />
    <Compile Include="RulesListTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.2.1" />
    <PackageReference Include="Expecto.FsCheck" Version="10.2.1" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.14.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Thoth.Json.Net" Version="12.*" />
    <!-- Pin Microsoft.Data.Sqlite to the SAME explicit version as Server (infra-001):
         without this the test process resolves the 9.0.11 facade transitively while
         Server.dll is compiled against 9.0.13, and the version skew triggers an
         intermittent SqliteConnection.RemoveCommand index-out-of-range during
         connection disposal on the first full suite run. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
    <ProjectReference Include="..\Server\Server.fsproj" />
    <ProjectReference Include="..\Client\Client.fsproj" />
  </ItemGroup>

</Project>
