<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <Watch Remove="data\**\*.*" />
    <Watch Remove="..\..\data\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ServerConfig.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="Ledger/Events.fs" />
    <!-- Der Spiegel-Contract (ADR 0014) liegt bewusst zwischen Events und Domain:
         `Ledger.Domain.observe` konsumiert ihn, er selbst leiht sich nur die beiden
         YNAB-geformten Wertobjekte aus `Ledger.Events`. -->
    <Compile Include="YnabObservations.fs" />
    <!-- Reine Memo-Kürzung, gemeinsam von YnabClient und Ledger.Domain genutzt
         (ledger-jkb0f): muss vor beiden stehen. -->
    <Compile Include="MemoFormatting.fs" />
    <Compile Include="PayeeFormatting.fs" />
    <Compile Include="Ledger/Domain.fs" />
    <Compile Include="Ledger/Persistence.fs" />
    <Compile Include="YnabClient.fs" />
    <Compile Include="ComdirectClient.fs" />
    <Compile Include="ComdirectAuthSession.fs" />
    <Compile Include="RulesEngine.fs" />
    <Compile Include="DuplicateDetection.fs" />
    <Compile Include="OrderIdMatcher.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="SyncSessionManager.fs" />
    <Compile Include="ImportAskLena.fs" />
    <Compile Include="Ledger/CommandHandlers.fs" />
    <Compile Include="Ledger/QueryHandlers.fs" />
    <Compile Include="Budgeting/Domain.fs" />
    <Compile Include="Budgeting/Persistence.fs" />
    <Compile Include="Budgeting/CommandHandlers.fs" />
    <Compile Include="PushOutcomeClassification.fs" />
    <Compile Include="BotApi.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Giraffe" Version="6.4.0" />
    <PackageReference Include="Fable.Remoting.Giraffe" Version="5.24.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="FsHttp" Version="14.*" />
    <PackageReference Include="Thoth.Json.Net" Version="12.*" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="4.*" />
    <PackageReference Include="YamlDotNet" Version="15.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Dapper" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.fsproj" />
  </ItemGroup>
</Project>
